 "_fields": {
  "active_s": "unit_special_abilities.active_time, s; -1: no duration (passive or instant)",
  "recharge_s": "unit_special_abilities.recharge_time, s; -1: none",
  "initial_s": "unit_special_abilities.initial_recharge, s: the ability is on cooldown this long from the battle's start (-1 and 0: ready at once; Steam guide 1698960734 'most abilities start at 0'; Gate of Khorne 60 = fandom)",
  "uses": "unit_special_abilities.num_uses; -1: unlimited",
  "vigour_per_s": "special_ability_phases.fatigue_change_ratio of the ability's phases (-0.01 for Foe-Seeker = fandom 'Vigour per second: -1%'): the share of the maximum fatigue (30000) the owner loses each second while it is active (negative: recovers; the in-game probe build/movelords: -300 points/s)",
  "cp": "unit_special_abilities.additional_melee_cp / additional_missile_cp: the ability's combat potential",
  "range_m": "unit_special_abilities.effect_range, m: the reach around the caster (0: itself)",
  "passive": "active_s and recharge_s both -1 (ours; the table's own passive column also marks Strength of the Penitent, our auto); checked against the cards' owned_passive lists",
  "targets_own": "unit_special_abilities.affect_self: the ability acts on its caster too",
  "friendly_units": "unit_special_abilities.num_effected_friendly_units: -1 all in range, n, 0 none",
  "enemy_units": "unit_special_abilities.num_effected_enemy_units: -1 all in range, n, 0 none",
  "update_targets": "unit_special_abilities.update_targets_every_frame: 1 - the ability picks its targets in range every frame, an aura that follows the caster (Rally, Hold the Line); 0 - it is laid once at the cast on the units in range, and they keep it for active_s wherever they go, later arrivals get nothing (Stand Your Ground; 142 recorded battles, build/effects/spec.md 3.2)",
  "self_cast": "active, not auto, affect_self, friendly_units and enemy_units 0 or -1 (ours): used on the caster himself, no target to choose (perform_special_ability(key, the lord))",
  "recharge_when": "special_ability_to_recharge_contexts.recharge_context of the ability: its recharge runs only while this holds (Strength of the Penitent: losing_melee_combat - 3 s while losing, CA hotfix 6.2.2; as the game acts on it: while not winning its melee, out of melee too - build/effectsimpl; Wounds: health_below_25% - its 5 s initial recharge runs once below a quarter); a passive without an active time is on only once it has recharged so",
  "off_when": "special_ability_to_auto_deactivate_flags.deactivate_flag: the effect switches off while this holds (Frenzy: morale_is_lower_than_half_of_base_morale; Penitent: out_of_melee)",
  "auto": "a timed passive (ours): an active time, a key with '_passive_' (the game lists it among the passives, unit_abilities) - the game fires it by itself whenever it is ready and nothing holds it off (off_when; the recordings: Strength of the Penitent on at the contact, 53 of 54, without losses too); no player or network order",
  "phases": "special_ability_to_special_ability_phase_junctions for the ability: the phase named as the ability when there is one, else all its phases",
  "targets": "the phases' target_self / target_friends / target_enemies (self-only abilities have 1 0 0, auras 1 1 0, hexes 0 0 1)",
  "effects": "special_ability_phase_stat_effects of the phases: stat, how (add or mult), value, and on whom (the phase's targets)",
  "attributes": "special_ability_phase_attribute_effects of the phases (attribute, attribute_type: positive/negative)",
  "heal": "only an ability whose phases heal (special_ability_phases heal_amount != 0: Regeneration): share - heal_amount, the share of the unit's largest health healed each tick; every_s - hp_change_frequency, the tick, s (Regeneration 0.001 every 1.0 s: the Brood Horror's 6009 HP heal 6 HP/s - the game's program, build/diag_skv_mon/mechanic.md M11: round(heal_amount x the power x the largest health) a tick)",
  "delay_s": "only a passive of several phases whose first phases lay nothing (Blackpowder Discipline: phase i 10 s, no stats, then phase ii): the special_ability_phases durations of those first phases, in the junctions' order - its effects come on once its conditions have held that long (ours: the phases run in order)"
