#!/bin/sh
# The fast tests before every commit (seconds): host python, the *_torch tests skip here - the drills' measures and
# the parity (contract/) run in the container: bash ops/dock.sh pytest -q (before a merge, by hand or by an agent).
# Enable once: git config core.hooksPath .githooks
# Skip only with a reason: git commit --no-verify
. ops/python.sh
"$PY" -m pytest -q -p no:cacheprovider || {
  echo "pre-commit: tests failed, commit stopped" >&2
  exit 1
}
