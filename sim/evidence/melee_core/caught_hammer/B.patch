+def facing_mix(u, pw, fighters, sector, attack, p, params, excluded):
+    """Expected hit chance by the opponent each struck cohort is occupied with."""
+    cc, rules = params.sim["contact"], params.battle
+    # Disengaging men have no reply to these incidental enemies during the exit window.
+    assigned = fighters
+    if cc.get("fresh_incidental") == 0 and "order_s" in u:
+        k = torch.arange(fighters.shape[-1], device=fighters.device)
+        silenced = ((u["order_kind"] == O.ATTACK) & (u["order_s"] < rules["melee_breakoff_secs"]))
+        assigned = torch.where(silenced[:, :, None] & (u["order_target"][:, :, None] != k), 0., assigned)
+    # [i,j,k]: incoming i seen by defender j while j faces opponent k.
+    incoming = pw["theta"].transpose(1, 2)
+    angle = geometry.wrap(incoming.unsqueeze(3) - pw["theta"].unsqueeze(1))
+    sides = geometry.sector(angle, cc["front_deg"], cc["rear_deg"])
+    # Match reciprocal fighters locally first. Surplus blows strike men busy facing another enemy.
+    reply = assigned.transpose(1, 2)
+    others = (assigned.sum(2)[:, None, :] - reply).clamp(min=0)
+    mutual = torch.where(others > 0, (reply / fighters.clamp(min=1e-6)).clamp(max=1), 1.)
+    can_turn = (assigned.sum(2) > 0)[:, None, :] & ~excluded
+    age = (u["face_pair_s"].view_as(p) - params.dt).clamp(min=0)
+    # Pooled KM median from the two probes for a defender targeting the same attacker: 2.5 s.
+    turned = torch.where(can_turn, 1 - torch.exp2(-age / 2.5), 0.)
+    mix = torch.zeros_like(p)
+    shares = []
+    for side, scale in enumerate((1., rules["melee_defence_direction_penalty_coefficient_flank"],
+                                  rules["melee_defence_direction_penalty_coefficient_rear"])):
+        weight = (assigned.unsqueeze(1) * (sides == side)).sum(3)
+        if side == 0:
+            weight = (weight - reply).clamp(min=0)
+        q = (1 - mutual) * weight / others.clamp(min=1e-6)
+        if side == 0:
+            q = q + mutual
+        q = (1 - turned) * (sector == side) + turned * q
+        shares.append(q)
+        defence = directional_defence(u["defence"][:, None, :], p.new_tensor(scale))
+        chance = hit_chance(attack, defence, rules["melee_hit_chance_normalisation_coefficient"],
+                            rules["melee_hit_chance_base"], rules["melee_hit_chance_min"],
+                            rules["melee_hit_chance_max"], float(params.sim["melee"].get("hit_roll_offset", 0.)))
+        mix = mix + q * chance
+    pw["facing_shares"] = shares
+    return torch.where(turned > 0, mix, p)
+
 
 
