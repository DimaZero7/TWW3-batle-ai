+"""Experimental free infantry files on an attack order issued during another contact."""
+import torch
+from sim import geometry, orders
+
+
+def ensure(u):
+    if "advance_target" in u:
+        return
+    count = max(1, int(u["men0"].max().item()))
+    b, n = u["men"].shape
+    u["advance_target"] = torch.full_like(u["order_target"], -1)
+    u["advance_distance"] = torch.zeros_like(u["men"])
+    for key in ("advance_x", "advance_z"):
+        u[key] = u["men"].new_zeros(b, n * count)
+    u["advance_free"] = torch.zeros(b, n * count, dtype=torch.bool, device=u["men"].device)
+
+
+def slot_distance(x, z, u, pw, b, j):
+    # Distance to the rectangle of enemy soldier centres, half a place inside each box edge.
+    angle = u["b"][b, j] * geometry.DEG
+    half_depth = (pw["depth"][b, j] - u["sp_v"][b, j]).clamp(min=0) / 2
+    half_width = (pw["front"][b, j] - u["sp_h"][b, j]).clamp(min=0) / 2
+    return geometry._box_point_dist(x, z, u["x"][b, j], u["z"][b, j], angle.sin(), angle.cos(),
+                                    half_depth, half_width)
+
+
+def arrivals(u, pw, touch, standing, changed, kind, target, run, rules, dt):
+    bsize, n = target.shape
+    count = u["advance_free"].shape[1] // n
+    j = target.clamp(min=0)
+    in_order = ((kind == orders.ATTACK) & (target >= 0) & standing & standing.gather(1, j)
+                & (u["range"] <= 0) & (u["men0"] > 1) & (u["men0"].gather(1, j) > 1)
+                & ~touch.gather(2, j.unsqueeze(2)).squeeze(2))
+    begin = in_order & changed & (touch & standing[:, None, :]).any(2)
+    tracking = in_order & (begin | (~changed & (u["advance_target"] == target)))
+    u["advance_target"] = torch.where(tracking, target, -1)
+    age_m = torch.where(tracking & ~begin, u["advance_distance"], 0.)
+    result = torch.zeros_like(pw["gap"])
+    # Free men start at their deployment-template places. Leave occupied places with the interceptor.
+    b, i = begin.nonzero(as_tuple=True)
+    reach = rules["entity_action_attack_formed_combat_distance"]
+    if b.numel():
+        h = u["sp_h"][b, i, None].clamp(min=1e-6)
+        v = u["sp_v"][b, i, None]
+        files = (pw["front"][b, i, None] / h).round().clamp(min=1)
+        k = torch.arange(count, device=b.device)[None, :]
+        dx = (k % files + .5) * h - pw["front"][b, i, None] / 2
+        dz = pw["depth"][b, i, None] / 2 - (torch.floor(k / files) + .5) * v
+        a = u["b"][b, i, None] * geometry.DEG
+        x = u["x"][b, i, None] + dx * a.cos() + dz * a.sin()
+        z = u["z"][b, i, None] - dx * a.sin() + dz * a.cos()
+        free = k < u["men"][b, i, None]
+        for enemy in range(n):
+            gap = slot_distance(x, z, u, pw, b[:, None], enemy)
+            free = free & ~(touch[b, i, enemy, None] & (gap <= reach + u["radius"][b, enemy, None]))
+        for key, value in (("advance_x", x), ("advance_z", z), ("advance_free", free)):
+            updated = u[key].clone().view(bsize, n, count)
+            updated[b, i] = value
+            u[key] = updated.flatten(1)
+    b, i = tracking.nonzero(as_tuple=True)
+    if b.numel():
+        j = target[b, i]
+        x, z, free = [u[key].view(bsize, n, count)[b, i] for key in ("advance_x", "advance_z", "advance_free")]
+        gap = slot_distance(x, z, u, pw, b[:, None], j[:, None])
+        arrived = free & (gap <= age_m[b, i, None] + reach + u["radius"][b, j, None])
+        result[b, i, j] = arrived.sum(1).to(result.dtype)
+    # Straight paths from each free place to the target box at the infantry order speed.
+    u["advance_distance"] = torch.where(tracking, age_m + torch.where(run, u["run"], u["walk"]) * dt, 0.)
+    return result
