# Out of git (the root's folders; anchored, so sim/data/ and the like stay in):
/tmp/
/state/
/data/
/weights/
/build/
/.venv/
# this machine's settings (bridge/config/local.example.json is the template)
/bridge/config/local.json
# reverse/: its own reverse/.gitignore (Ghidra, JDK, the project, exe and venv in reverse/ghidra/; the topics' raw
# .c / dumps in reverse/notes/<topic>/ - only the notes' .md and .py are in git)
__pycache__/
*.pyc
.pytest_cache/
# Windows leftovers of bash and redirects
nul
*.stackdump
