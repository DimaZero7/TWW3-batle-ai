# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Build output and local runs
build/

# Machine-specific settings (see config/default.json)
config/local.json
# Local Claude Code settings of this machine
.claude/settings.local.json

# IDE
.idea/
.vscode/

# Raw research data (grids, logs, arrays, summaries): kept on the local disk,
# not in Git. Images and descriptions stay in the repository.
research/evidence/**
!research/evidence/**/
!research/evidence/**/*.png
!research/evidence/**/*.svg
!research/evidence/**/*.md
# Analysis output is the same: data stays local, only pictures and write-ups
# are committed (user, 27.09.2026: analysis data is never committed).
research/analysis/**
!research/analysis/**/
!research/analysis/**/*.png
!research/analysis/**/*.svg
!research/analysis/**/*.md

# personal working rules of the orchestrator with the user (auto-loaded by Claude Code)
CLAUDE.local.md
